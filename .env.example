# ──────────────────────────────────────────────────────
# Senda Seguros CRM — Variables de entorno
# Copia este archivo como .env.local y completa los valores
# ──────────────────────────────────────────────────────

# URL del proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave pública (publishable / anon key) — se expone al cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clave secreta (service role) — NUNCA la expongas en el frontend
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
